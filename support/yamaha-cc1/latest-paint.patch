+++ b/src/motor-fader.test.ts
@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict'
+import { MotorFader } from './motor-fader.js'
+const fader = new MotorFader()
+assert.equal(fader.setTarget(75),75)
+for (const position of [0,100,500,767]) assert.deepEqual(fader.input(position,false),{})
+assert.deepEqual(fader.input(512,true),{value:50})
+assert.equal(fader.setTarget(20),undefined)
+assert.equal(fader.setTarget(80),undefined)
+assert.deepEqual(fader.input(512,false),{motor:80})
+assert.deepEqual(fader.input(818,false),{})
+assert.equal(fader.setTarget('bad'),undefined)
+assert.equal(fader.target,80)
+assert.equal(fader.setTarget(''),undefined)
+assert.equal(fader.setTarget(null),undefined)
+assert.equal(fader.setTarget(200),100)
+assert.deepEqual(fader.input(1023,true),{value:100})
+assert.deepEqual(fader.input(0,true),{value:0})
+console.log('motor-fader: OK — recall echoes ignored, touched input preserved, deferred target restored')
