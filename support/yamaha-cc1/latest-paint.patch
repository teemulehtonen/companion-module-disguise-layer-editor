diff --git a/src/paint-queue.ts b/src/paint-queue.ts
new file mode 100644
--- /dev/null
+++ b/src/paint-queue.ts
@@ -0,0 +1,34 @@
+/** One in-flight paint and one latest pending paint per LCD key.
+ * Preserve key order for fairness; replacing a pending image never adds backlog.
+ */
+export class LatestPaintQueue<T> {
+  #pending = new Map<number, T>()
+  #running: Promise<void> | undefined
+  #closed = false
+  constructor(
+    private readonly paint: (key: number, value: T) => Promise<void>,
+    private readonly onError: (error: unknown) => void,
+  ) {}
+  enqueue(key: number, value: T): void {
+    if (this.#closed) return
+    this.#pending.set(key, value)
+    if (!this.#running) {
+      this.#running = Promise.resolve().then(() => this.#drain()).finally(() => { this.#running = undefined; if (!this.#closed && this.#pending.size) { const [key, value] = this.#pending.entries().next().value!; this.enqueue(key, value) } })
+    }
+  }
+  async #drain(): Promise<void> {
+    while (!this.#closed && this.#pending.size) {
+      const [key, value] = this.#pending.entries().next().value!
+      this.#pending.delete(key)
+      try { await this.paint(key, value) }
+      catch (error) { this.onError(error) }
+    }
+  }
+  async idle(): Promise<void> {
+    while (this.#running) await this.#running
+  }
+  close(): void {
+    this.#closed = true
+    this.#pending.clear()
+  }
+}
diff --git a/src/paint-queue.test.ts b/src/paint-queue.test.ts
new file mode 100644
--- /dev/null
+++ b/src/paint-queue.test.ts
@@ -0,0 +1,54 @@
+import assert from 'node:assert/strict'
+import { LatestPaintQueue } from './paint-queue.js'
+
+let release!: () => void
+const gate = new Promise<void>(resolve => { release = resolve })
+const sent: [number, number][] = []
+const queue = new LatestPaintQueue<number>(async (key, value) => {
+  sent.push([key, value])
+  if (sent.length === 1) await gate
+}, error => { throw error })
+queue.enqueue(0, 0)
+await Promise.resolve()
+assert.deepEqual(sent, [[0, 0]])
+for (let value = 1; value <= 500; value++) {
+  queue.enqueue(0, value)
+  queue.enqueue(1, value)
+}
+// A new page replaces every waiting old-page image, including rapidly updated clocks.
+for (let key = 0; key < 12; key++) queue.enqueue(key, 1000 + key)
+assert.equal(sent.length, 1, 'only one paint may be in flight')
+release()
+await queue.idle()
+assert.deepEqual(sent, [[0, 0], ...Array.from({ length: 12 }, (_, key) => [key, 1000 + key])])
+queue.enqueue(2, 2000)
+await queue.idle()
+assert.deepEqual(sent.at(-1), [2, 2000], 'queue restarts after becoming idle')
+
+let releaseClose!: () => void
+const closeGate = new Promise<void>(resolve => { releaseClose = resolve })
+const closedSent: number[] = []
+const closed = new LatestPaintQueue<number>(async (_key, value) => {
+  closedSent.push(value)
+  await closeGate
+}, error => { throw error })
+closed.enqueue(0, 1)
+await Promise.resolve()
+closed.enqueue(1, 2)
+closed.close()
+closed.enqueue(2, 3)
+releaseClose()
+await closed.idle()
+assert.deepEqual(closedSent, [1], 'shutdown discards all pending paints')
+
+const errors: unknown[] = [], recovered: number[] = []
+const recovery = new LatestPaintQueue<number>(async (_key, value) => {
+  if (value === 1) throw Error('failed paint')
+  recovered.push(value)
+}, error => { errors.push(error) })
+recovery.enqueue(0, 1)
+recovery.enqueue(1, 2)
+await recovery.idle()
+assert.equal(errors.length, 1)
+assert.deepEqual(recovered, [2], 'failed paint does not replay or block later keys')
+console.log('paint-queue: OK - bounded backlog, latest page, fairness, idle, close and failure')
diff --git a/src/motor-fader.ts b/src/motor-fader.ts
new file mode 100644
--- /dev/null
+++ b/src/motor-fader.ts
@@ -0,0 +1,19 @@
+// Separate physical input from motor travel so recalling a channel cannot overwrite it.
+export class MotorFader {
+  touched = false
+  target: number | undefined
+  setTarget(value: unknown): number | undefined {
+    if (typeof value !== 'number' && typeof value !== 'string') return
+    if (value === '') return
+    const number = Number(value)
+    if (!Number.isFinite(number)) return
+    this.target = Math.max(0, Math.min(100, number))
+    return this.touched ? undefined : this.target
+  }
+  input(position: number, touched: boolean): { value?: number; motor?: number } {
+    const released = this.touched && !touched
+    this.touched = touched
+    if (touched) return {value: Math.round(Math.max(0, Math.min(1023, position)) / 1023 * 1000) / 10}
+    return released ? {motor:this.target} : {}
+  }
+}
