{
  "name": "companion-module-disguise-layer-control",
  "version": "0.2.0-beta.84",
  "private": true,
  "description": "Disguise Designer layer and keyframe control for Yamaha CC1 through Companion",
  "main": "src/entry.mjs",
  "license": "MIT",
  "engines": {
    "node": ">=22.20 <23"
  },
  "scripts": {
    "test": "node --test",
    "test:regression": "node scripts/regression.cjs",
    "package": "companion-module-build --prerelease && node scripts/verify-package.mjs && node scripts/build-page.cjs",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "format": "prettier --write \"src/**/*.{js,mjs}\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,mjs}\" \"test/**/*.js\""
  },
  "dependencies": {
    "@companion-module/base": "2.1.3"
  },
  "devDependencies": {
    "@companion-module/tools": "3.1.0",
    "prettier": "3.9.8"
  }
}
